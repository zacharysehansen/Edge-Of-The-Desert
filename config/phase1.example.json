{
  "project": {
    "name": "Southwest Water Sustainability Visualizer",
    "start_year_month": "2000-01",
    "end_year_month": "2023-12"
  },
  "paths": {
    "raw_dir": "data/raw",
    "processed_dir": "data/processed",
    "final_dir": "data/Final"
  },
  "study_area": {
    "name": "Southern Arizona eight-county region",
    "bbox": {
      "min_lon": -114.81,
      "min_lat": 31.33,
      "max_lon": -109.05,
      "max_lat": 34.5
    },
    "state_fips": "04",
    "state_abbr": "AZ",
    "counties": [
      "Pima",
      "Pinal",
      "Santa Cruz",
      "Cochise",
      "Graham",
      "Greenlee",
      "Yuma",
      "La Paz"
    ],
    "county_fips": [
      "04019",
      "04021",
      "04023",
      "04003",
      "04013",
      "04011",
      "04027",
      "04007"
    ]
  },
  "sources": [
    {
      "name": "modis_ndvi",
      "kind": "earthdata_modis_hdf",
      "enabled": true,
      "short_name": "MOD13A3",
      "subdataset_contains": "1 km monthly NDVI",
      "feature_name": "ndvi",
      "bbox": [-114.85, 31.25, -109.0, 37.1],
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "scale_factor": 10000.0,
      "invalid_below": -2000
    },
    {
      "name": "merra_temperature_2m",
      "kind": "earthdata_grid_netcdf",
      "enabled": true,
      "short_name": "M2SMNXSLV",
      "variable": "T2MMEAN",
      "feature_name": "temperature_2m_c",
      "bbox": [-114.85, 31.25, -109.0, 37.1],
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "transform": "kelvin_to_celsius"
    },
    {
      "name": "merra_specific_humidity_2m",
      "kind": "earthdata_grid_netcdf",
      "enabled": true,
      "short_name": "M2TMNXFLX",
      "variable": "QSH",
      "feature_name": "specific_humidity_2m",
      "bbox": [-114.85, 31.25, -109.0, 37.1],
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "transform": "identity"
    },
    {
      "name": "merra_precipitation",
      "kind": "earthdata_grid_netcdf",
      "enabled": true,
      "short_name": "M2TMNXFLX",
      "variable": "PRECTOT",
      "feature_name": "precipitation_mm_day",
      "bbox": [-114.85, 31.25, -109.0, 37.1],
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "transform": "kg_m2_s_to_mm_day"
    },
    {
      "name": "grace_groundwater_anomaly",
      "kind": "earthdata_grid_netcdf",
      "enabled": true,
      "short_names": [
        "TELLUS_GRAC_L3_JPL_RL06_LND_v04",
        "TELLUS_GRFO_L3_JPL_RL06.3_LND_v04"
      ],
      "variable": "lwe_thickness",
      "feature_name": "grace_groundwater_anomaly",
      "bbox": [-114.85, 31.25, -109.0, 37.1],
      "start_date": "2002-04-01",
      "end_date": "2023-12-31",
      "transform": "identity"
    },
    {
      "name": "grace_recharge_estimate",
      "kind": "derived_monthly_delta",
      "enabled": true,
      "input_source": "grace_groundwater_anomaly",
      "input_column": "grace_groundwater_anomaly",
      "feature_name": "grace_recharge_estimate",
      "positive_only": true,
      "fill_value": 0.0
    },
    {
      "name": "usgs_streamflow",
      "kind": "usgs_daily_value",
      "enabled": true,
      "site_numbers": ["09380000", "09498500", "09506000"],
      "parameter_code": "00060",
      "feature_name": "streamflow_cfs",
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "group_aggregation": "mean"
    },
    {
      "name": "lake_mead_level",
      "kind": "rise_results",
      "enabled": false,
      "location_id": 3514,
      "parameter_id": 3,
      "catalog_item_id": 6123,
      "feature_name": "lake_mead_level_ft",
      "start_date": "2000-01-01",
      "end_date": "2023-12-31"
    },
    {
    
      "name": "azpop",
      "kind": "manual_monthly_csv",
      "enabled": true,
      "path": "AZPOP.csv",
      "feature_columns": ["AZPOP"]
    },
    {      "name": "population",
      "kind": "census_county_population",
      "enabled": true,
      "state_fips": "04",
      "county_fips": [
        "04019",
        "04021",
        "04023",
        "04003",
        "04013",
        "04011",
        "04027",
        "04007"
      ],
      "feature_name": "population",
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "aggregation": "county_sum",
      "interpolation": "monthly"
    },
    {
      "name": "urbanization",
      "kind": "earthdata_nlcd_impervious",
      "enabled": false,
      "feature_name": "impervious_pct",
      "start_date": "2000-01-01",
      "end_date": "2023-12-31",
      "source_url": "s3://usgs-landcover/annual-nlcd/c1/v0/cu/mosaic/"
    },
    {
      "name": "water_stress",
      "kind": "derived_usdm_sustainability",
      "enabled": false,
      "input_source": "usdm_sustainability",
      "feature_name": "water_stress_score"
    },
    {
      "name": "groundwater_wells",
      "kind": "usgs_groundwater_well_level",
      "enabled": false,
      "feature_name": "well_level_ft",
      "ama_filter": [
        "Tucson",
        "Santa Cruz"
      ]
    },
    {
      "name": "wildfire",
      "kind": "manual_fire_event_csv",
      "enabled": false,
      "path": "wildfire_events.csv",
      "year_column": "FIRE_YEAR",
      "acres_column": "Acres",
      "feature_name": "wildfire_risk_index"
    },
    {
      "name": "wildlife_bbs",
      "kind": "sciencebase_bbs",
      "enabled": false,
      "source": "sciencebase",
      "feature_name": "wildlife_abundance",
      "start_date": "2000-01-01",
      "end_date": "2024-12-31"
    },
    { "name": "irrigation_huc12",
      "kind": "manual_huc12_wide_csv",
      "enabled": true,
      "path": "ir_huc12_tot_wd_az_2000_2020.csv",
      "year_column": "Year",
      "month_column": "Month",
      "feature_name": "irrigation_withdrawal",
      "aggregation": "statewide_sum",
      "notes": "Requires reshape from wide HUC12 columns to aggregated monthly feature"
    },

    {
      "name": "public_supply_huc12",
      "kind": "manual_huc12_wide_csv",
      "enabled": true,
      "path": "ps_huc12_tot_az_2000_2020.csv",
      "year_column": "Year",
      "month_column": "Month",
      "feature_name": "public_supply_withdrawal",
      "aggregation": "statewide_sum",
      "notes": "Requires reshape from wide HUC12 columns to aggregated monthly feature"
    }
  ]
}
